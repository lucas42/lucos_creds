<html>
	<head>
		<title>LucOs Credentials - <%= system %>: <%= environment %></title>
		<meta name="viewport" content="initial-scale=1.0, user-scalable=no, width=device-width" />
		<link href="/style.css" rel="stylesheet" />
		<link rel="icon" href="/icon.png" />
		<link rel="manifest" href="/manifest.json" />
	</head>
	<body>
		<lucos-navbar bg-colour="#334" aithne-origin="<%= AITHNE_ORIGIN %>">Creds</lucos-navbar>
		<nav id="breadcrumbs">
			<a href="/">Credentials</a> &gt;
			<a href="/system/<%=encodeURI(system)%>"><%= system.replaceAll("_"," ") %></a> &gt;
			<span><%= environment %></span>
		</nav>
		<main>
			<h1><span class="system-name"><%= system.replaceAll("_", " ") %>:</span> <span class="environment-name environment-<%= environment %>"><%= environment %></span></h1>
			<ul id="credential-list">
				<% for(const key in creds) {
					const viewpath = `/system/${encodeURI(system)}/${encodeURI(environment)}/${encodeURI(key)}`;
				%>
				<li>
					<span class="key"><%= key %></span>
					<form action="<%= viewpath %>" method="get" class="inline-form">
						<button type="submit" title="View Credential" class="inline-button view-button"><%- icon('eye') %><span class="sr-only">View Credential</span></button>
					</form>
					<% if (creds[key].type == "simple") { %>
						<form action="/update-simple-credential" method="get" class="inline-form">
							<input type="hidden" name="system" value="<%= system %>" />
							<input type="hidden" name="environment" value="<%= environment %>" />
							<input type="hidden" name="key" value="<%= key %>" />
							<button type="submit" title="Edit Credential" class="inline-button edit-button"><%- icon('pencil') %><span class="sr-only">Edit Credential</span></button>
						</form>
						<form action="/delete-simple-credential" method="get" class="inline-form">
							<input type="hidden" name="system" value="<%= system %>" />
							<input type="hidden" name="environment" value="<%= environment %>" />
							<input type="hidden" name="key" value="<%= key %>" />
							<button type="submit" title="Delete Credential" class="inline-button delete-button"><%- icon('trash') %><span class="sr-only">Delete Credential</span></button>
						</form>
					<% } else if (creds[key].type == "client") { %>
						<form action="/update-linked-credential" method="get" class="inline-form">
							<input type="hidden" name="clientsystem" value="<%= system %>" />
							<input type="hidden" name="clientenvironment" value="<%= environment %>" />
							<input type="hidden" name="serversystem" value="<%= key.replace("KEY_", "").toLowerCase() %>" />
							<button type="submit" title="Refresh Credential" class="inline-button refresh-button"><%- icon('refresh') %><span class="sr-only">Refresh Credential</span></button>
						</form>
						<form action="/delete-linked-credential" method="get" class="inline-form">
							<input type="hidden" name="clientsystem" value="<%= system %>" />
							<input type="hidden" name="clientenvironment" value="<%= environment %>" />
							<input type="hidden" name="serversystem" value="<%= key.replace('KEY_', '').toLowerCase() %>" />
							<input type="hidden" name="serverenvironment" value="" />
							<button type="submit" title="Delete Linked Credential" class="inline-button delete-button"><%- icon('trash') %><span class="sr-only">Delete Linked Credential</span></button>
						</form>
					<% } else if (creds[key].type == "server") { %>
						<form action="/update-linked-credential" method="get" class="inline-form">
							<input type="hidden" name="serversystem" value="<%= system %>" />
							<input type="hidden" name="serverenvironment" value="<%= environment %>" />
							<button type="submit" title="Add Linked Credential where this system is the server" class="inline-button add-button"><%- icon('plus') %><span class="sr-only">Add Linked Credential</span></button>
						</form>
					<% } %>
				</li>
				<% } %>
			</ul>
			<h3>Add New Credential</h3>
			<div class="button-set">
				<form action="/update-simple-credential" method="get" class="inline-form">
					<input type="hidden" name="system" value="<%= system %>" />
					<input type="hidden" name="environment" value="<%= environment %>" />
					<button type="submit" title="Add Simple Credential" class="inline-button add-button"><%- icon('plus') %><span>Add Simple</span></button>
				</form>
				<form action="/update-linked-credential" method="get" class="inline-form">
					<input type="hidden" name="clientsystem" value="<%= system %>" />
					<input type="hidden" name="clientenvironment" value="<%= environment %>" />
					<button type="submit" title="Add Linked Credential where this system is the client" class="inline-button add-button"><%- icon('plus') %><span>Add Client</span></button>
				</form>
				<form action="/update-linked-credential" method="get" class="inline-form">
					<input type="hidden" name="serversystem" value="<%= system %>" />
					<input type="hidden" name="serverenvironment" value="<%= environment %>" />
					<button type="submit" title="Add Linked Credential where this system is the server" class="inline-button add-button"><%- icon('plus') %><span>Add Server</span></button>
				</form>
			</div>
		</main>
		<script type="text/javascript" src="/client.js"></script>
	</body>
</html>